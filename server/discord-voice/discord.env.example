# Copy to discord.env and fill in. discord.env holds a secret: never commit it.

# Required: Developer Portal > your application > Bot > Reset Token.
DISCORD_TOKEN=

# Optional: the server (guild) the bot manages. Empty means the first server the bot is in.
# Discord: User Settings > Advanced > Developer Mode, then right-click the server > Copy Server ID.
DISCORD_GUILD_ID=

# Optional: categories are named "<prefix> <ROOM>", for example "Last Call ABCD".
CHANNEL_PREFIX=Last Call
